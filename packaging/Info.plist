<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- scripts/package.sh fills in @VERSION@ and @BUILD@. -->
<plist version="1.0">
<dict>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleName</key>
  <string>InkStudio</string>
  <key>CFBundleDisplayName</key>
  <string>InkStudio</string>
  <key>CFBundleExecutable</key>
  <string>InkStudio</string>
  <key>CFBundleIdentifier</key>
  <string>io.github.inkcheck.inkstudio</string>
  <key>CFBundleShortVersionString</key>
  <string>@VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@BUILD@</string>
  <key>CFBundleIconFile</key>
  <string>inkstudio</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>LSMinimumSystemVersion</key>
  <string>13.0</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSHumanReadableCopyright</key>
  <string>Apache License 2.0</string>

  <!-- .inktheme: a zip of one inkpress template pack. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>io.github.inkcheck.inktheme</string>
      <key>UTTypeDescription</key>
      <string>InkStudio theme</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.zip-archive</string>
        <string>public.data</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>inkstudio</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>inktheme</string>
        </array>
      </dict>
    </dict>
  </array>

  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>InkStudio theme</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>io.github.inkcheck.inktheme</string>
      </array>
    </dict>
    <!-- Folders: an inkpress pack dropped on the app or its Dock icon. -->
    <dict>
      <key>CFBundleTypeName</key>
      <string>Folder</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.folder</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
